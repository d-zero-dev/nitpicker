{
	"import": ["@d-zero/cspell-config"],
	"ignorePaths": ["*.sqlite", "**/CODEOWNERS"],
	"words": [
		// nitpicker
		"readtext",

		// HTML
		"noarchive",
		"rels", // refers to "relationships"
		"Hrefs",

		// VS Code extensions
		"dbaeumer",
		"esbenp",

		// nitpicker
		"nitpicker",
		"googleapis",
		"gaxios",
		"enquirer",
		"jsdom",
		"cosmiconfig",
		"nitpickerrc",
		"textlint",
		"markuplint",
		"turndown",
		"sudachi",
		"prh",
		"hojodoushi",
		"keishikimeishi",
		"fukushi",
		"desumasu",
		"dearu",

		// robots.txt
		"robotstxt",

		//
		"untar",
		"apng",
		"whatwg",
		"PHPSESSID",
		"wcag",

		// HTTP encoding
		"sdch",
		"vcdiff",
		"xdelta",

		// Japanese text rules (textlint plugin names)
		"hankaku",
		"zenkaku",
		"appearence",
		"tari",

		// libraries / authors
		"medv",

		// technical terms
		"Upserts",
		"TOCTOU",
		"qmark",
		"dedup",
		"unstarted",
		"mmm",

		// Security headers
		"HSTS",

		// Tracking pixel / ads URL conventions (used in docs and dedupe examples)
		"pagead",
		"auid",
		"capi",

		// Natural-sort algorithm reference (Martin Pool)
		"strnatcmp",
		"isdigit",
		"isspace",
		"tolower",

		// CI / GitHub Actions (Chromium sandbox on ubuntu runners)
		"apparmor",
		"userns",

		// HTML page file extensions (isLikelyHtmlUrl heuristic)
		"xhtml",
		"shtml",
		"phtml",
		"mhtml",
		"jspx",
		"ashx",
		"jsf",
		"htaccess",

		// Viewer frontend stack
		"tanstack",
		"srcdoc",
		"hono",
		"rollup",
		"favicon",
		"clientside"
	]
}
