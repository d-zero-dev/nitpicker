{
	"import": ["@d-zero/cspell-config"],
	"ignorePaths": [
		"*.sqlite",
		"**/CODEOWNERS",
		"inventory-*.csv",
		"inventory-*.md",
		"*-inventory-*.csv",
		"*-inventory-*.md",
		"bench-output/**"
	],
	"words": [
		// Misra-Gries algorithm (DedupeCapTracker, issue #208)
		"Misra",
		"Gries",

		// SQLite PRAGMA table_info() column name
		"dflt",

		// nitpicker
		"readtext",
		"unanalyzed",
		"Untarring",
		"untars",

		// viewer_duplicate_group_pages index abbreviation (issue #115)
		"vdgp",
		"vicp",
		"indegree",

		// Filesystems / OS storage primitives (tar cache documentation)
		"APFS",
		"tmpfs",
		"statfs",
		"bavail",

		// English compounds used in technical commentary
		"unsuffixed",
		"greppable",
		"desync",
		"lossily",
		"unfinalized",

		// HTML
		"noarchive",
		"rels", // refers to "relationships"
		"Hrefs",

		// VS Code extensions
		"dbaeumer",
		"esbenp",

		// nitpicker
		"nitpicker",
		"googleapis",
		"gaxios",
		"enquirer",
		"jsdom",
		"cosmiconfig",
		"nitpickerrc",
		"textlint",
		"markuplint",
		"turndown",
		"sudachi",
		"prh",
		"hojodoushi",
		"keishikimeishi",
		"fukushi",
		"desumasu",
		"dearu",

		// robots.txt
		"robotstxt",

		//
		"untar",
		"ustar", // tar archive format identifier (POSIX IEEE 1003.1)
		"apng",
		"whatwg",
		"PHPSESSID",
		"wcag",

		// Microsoft Office Open XML MIME-type vendor strings (e.g.
		// application/vnd.openxmlformats-officedocument.wordprocessingml.document).
		"wordprocessingml",
		"spreadsheetml",
		"presentationml",

		// HTTP encoding
		"sdch",
		"vcdiff",
		"xdelta",

		// Japanese text rules (textlint plugin names)
		"hankaku",
		"zenkaku",
		"appearence",
		"tari",

		// libraries / authors
		"medv",

		// @d-zero/page-cluster (Jaccard similarity coefficient)
		"Jaccard",

		// technical terms
		"Upserts",
		"TOCTOU",
		"qmark",
		"dedup",
		"dedups",
		"unstarted",
		"mmm",
		"mmap",
		"zstd",

		// Network / DNS / HTTP error tokens
		"NXDOMAIN",
		"libc",
		"RTSP",
		"CORB", // Chromium Cross-Origin Read Blocking (ERR_BLOCKED_BY_ORB predecessor)

		// Security headers
		"HSTS",

		// Tracking pixel / ads URL conventions (used in docs and dedupe examples)
		"pagead",
		"auid",
		"capi",

		// Natural-sort algorithm reference (Martin Pool)
		"strnatcmp",
		"isdigit",
		"isspace",
		"tolower",

		// CI / GitHub Actions (Chromium sandbox on ubuntu runners)
		"apparmor",
		"userns",

		// HTML page file extensions (isLikelyHtmlUrl heuristic)
		"xhtml",
		"shtml",
		"phtml",
		"mhtml",
		"jspx",
		"ashx",
		"jsf",
		"htaccess",

		// Viewer frontend stack
		"tanstack",
		"srcdoc",
		"hono",
		"rollup",
		"favicon",
		"clientside",
		"unstub",

		// beholder 3.0.0 nested Meta terms
		"Wappalyzer",
		"noimageindex",
		"deserialised",
		"denorm",
		"absolutised",
		"absolutises",
		"absolutisation",
		"unparseable",
		"speculationrules",
		"hreflang",
		"amphtml",
		"itemprop",
		"itemtype",
		"itemscope",
		"openidserver",
		"openid",
		"originTrial",
		"jsonld",
		"camelCase",
		"Wikipedia",
		"msapplication",

		// Test fixtures (people)
		"Yusuke",
		"Hirao",

		// Claude Code effort levels (referenced in commit messages / CHANGELOG)
		"xhigh",

		// Technology stack detection (Astro/Next.js/Vue/Angular structural signals)
		"ngcontent", // Angular's `_ngcontent-*` scoped-attribute marker
		"uncurated",

		// query/src/list-pages-by-technology.ts (page_technologies alias, avoids
		// colliding with page_templates' hardcoded `pt` alias)
		"ptech",

		// viewer_technology_directory_stats index name abbreviation
		"vtds"
	]
}
