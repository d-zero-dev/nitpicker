{
	"import": ["@d-zero/cspell-config"],
	"ignorePaths": ["*.sqlite", "**/CODEOWNERS"],
	"words": [
		// nitpicker
		"readtext",
		"unanalyzed",
		"Untarring",

		// HTML
		"noarchive",
		"rels", // refers to "relationships"
		"Hrefs",

		// VS Code extensions
		"dbaeumer",
		"esbenp",

		// nitpicker
		"nitpicker",
		"googleapis",
		"gaxios",
		"enquirer",
		"jsdom",
		"cosmiconfig",
		"nitpickerrc",
		"textlint",
		"markuplint",
		"turndown",
		"sudachi",
		"prh",
		"hojodoushi",
		"keishikimeishi",
		"fukushi",
		"desumasu",
		"dearu",

		// robots.txt
		"robotstxt",

		//
		"untar",
		"apng",
		"whatwg",
		"PHPSESSID",
		"wcag",

		// Microsoft Office Open XML MIME-type vendor strings (e.g.
		// application/vnd.openxmlformats-officedocument.wordprocessingml.document).
		"wordprocessingml",
		"spreadsheetml",
		"presentationml",

		// HTTP encoding
		"sdch",
		"vcdiff",
		"xdelta",

		// Japanese text rules (textlint plugin names)
		"hankaku",
		"zenkaku",
		"appearence",
		"tari",

		// libraries / authors
		"medv",

		// technical terms
		"Upserts",
		"TOCTOU",
		"qmark",
		"dedup",
		"dedups",
		"unstarted",
		"mmm",
		"mmap",
		"zstd",

		// Network / DNS / HTTP error tokens
		"NXDOMAIN",
		"libc",
		"RTSP",
		"CORB", // Chromium Cross-Origin Read Blocking (ERR_BLOCKED_BY_ORB predecessor)

		// Security headers
		"HSTS",

		// Tracking pixel / ads URL conventions (used in docs and dedupe examples)
		"pagead",
		"auid",
		"capi",

		// Natural-sort algorithm reference (Martin Pool)
		"strnatcmp",
		"isdigit",
		"isspace",
		"tolower",

		// CI / GitHub Actions (Chromium sandbox on ubuntu runners)
		"apparmor",
		"userns",

		// HTML page file extensions (isLikelyHtmlUrl heuristic)
		"xhtml",
		"shtml",
		"phtml",
		"mhtml",
		"jspx",
		"ashx",
		"jsf",
		"htaccess",

		// Viewer frontend stack
		"tanstack",
		"srcdoc",
		"hono",
		"rollup",
		"favicon",
		"clientside",

		// beholder 3.0.0 nested Meta terms
		"Wappalyzer",
		"noimageindex",
		"deserialised",
		"denorm",
		"absolutised",
		"absolutises",
		"absolutisation",
		"unparseable",
		"speculationrules",
		"hreflang",
		"amphtml",
		"itemprop",
		"itemtype",
		"itemscope",
		"openidserver",
		"openid",
		"originTrial",
		"jsonld",
		"camelCase",
		"Wikipedia",
		"msapplication",

		// Test fixtures (people)
		"Yusuke",
		"Hirao"
	]
}
