{
	"extends": ["@d-zero/markuplint-config/base", "@d-zero/markuplint-config/jsx"],
	"pretenders": {
		"auto": true
	},
	"overrides": {
		"packages/@nitpicker/viewer/web/index.html": {
			"rules": {
				"require-h1": false
			}
		},
		"packages/**/web/**/*.{tsx,jsx}": {
			"rules": {
				"security/no-event-handler-attr": {
					"rules": {
						"no-event-handler-attr": {
							"value": true,
							"options": {
								"ignore": [
									"onChange",
									"onKeyDown",
									"onMouseDown",
									"onTouchStart",
									"onScroll",
									"onSubmit"
								]
							}
						}
					}
				}
			},
			"nodeRules": [
				{
					"selector": "table.vt-table, table.pt-table",
					"rules": {
						"no-redundant-role": false
					}
				},
				{
					"selector": "tr[role=row]",
					"rules": {
						"no-redundant-role": false,
						"permitted-roles": false,
						"require-owned-elements": false
					}
				},
				{
					"selector": "td[aria-colindex]",
					"rules": {
						"aria-prop-requires-role": false
					}
				},
				{
					"selector": "#tree-collapse-depth-input, #tree-sort-order-select",
					"rules": {
						"no-hardcoded-id": false
					}
				},
				{
					"selector": "button.tree-toggle",
					"rules": {
						"element-supports-aria-prop": false
					}
				},
				{
					"name": "performance/iframe-lazy-loading",
					"specConformance": "non-normative",
					"selector": "iframe:not(.hp-frame)",
					"rules": {
						"require-attr": [
							"title",
							{
								"name": "loading",
								"value": "lazy"
							}
						]
					}
				},
				{
					"selector": "button.icon-button",
					"rules": {
						"no-redundant-accessible-name": false
					}
				}
			]
		},
		"packages/@nitpicker/viewer/web/components/{paged-table,virtual-table}.tsx": {
			"rules": {
				"a11y/no-empty-table-track": false,
				"a11y/table-row-column-alignment": false
			}
		}
	}
}
