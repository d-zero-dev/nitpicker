{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"configMigration": true,
	"extends": [
		"config:recommended",
		"docker:pinDigests",
		"helpers:pinGitHubActionDigestsToSemver",
		":pinDevDependencies",
		":semanticCommitTypeAll(chore)"
	],
	"baseBranchPatterns": ["dev"],
	"timezone": "Asia/Tokyo",
	"rangeStrategy": "pin",
	"minimumReleaseAge": "3 days",
	"internalChecksFilter": "strict",
	"prConcurrentLimit": 0,
	"prHourlyLimit": 0,
	"platformAutomerge": true,
	"osvVulnerabilityAlerts": true,
	"vulnerabilityAlerts": {
		"enabled": true,
		"minimumReleaseAge": null,
		"labels": ["security"]
	},
	"labels": ["Dependencies", "Renovate"],
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true,
		"schedule": ["* 0-4 * * *"]
	},
	"customManagers": [
		{
			"customType": "regex",
			"description": "Rule 44: the Corepack version every workflow installs; one PR updates them all",
			"managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
			"matchStrings": [
				"npm install --global corepack@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
			],
			"depNameTemplate": "corepack",
			"datasourceTemplate": "npm"
		}
	],
	"packageRules": [
		{
			"matchDepTypes": ["optionalDependencies"],
			"addLabels": ["Dependencies: Optional"]
		},
		{
			"matchDepTypes": ["devDependencies"],
			"addLabels": ["Dependencies: Development"]
		},
		{
			"matchDepTypes": ["dependencies"],
			"addLabels": ["Dependencies: Production"]
		},
		{
			"description": "Rule 1: every update automerges once the required CI passes, 0.x and majors included",
			"matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
			"automerge": true
		},
		{
			"description": "Rule 11: pinGitHubActionDigestsToSemver raises each release as a version update; the digest update of the same commit carries no release date and never passes minimumReleaseAge",
			"matchManagers": ["github-actions"],
			"matchUpdateTypes": ["digest"],
			"enabled": false
		},
		{
			"description": "Rule 4: lock file maintenance has no release dates to wait on (the package manager's age gate holds new versions back) and is never held back by other PRs",
			"matchUpdateTypes": ["lockFileMaintenance"],
			"minimumReleaseAge": null,
			"prConcurrentLimit": 0,
			"prHourlyLimit": 0
		},
		{
			"description": "Rule 7: published packages raise the lower bound of their dependency ranges, and an update of them reaches users as a fix",
			"matchFileNames": ["packages/**/package.json"],
			"matchDepTypes": ["dependencies"],
			"rangeStrategy": "bump",
			"semanticCommitType": "fix",
			"semanticCommitScope": "deps"
		},
		{
			"description": "Rule 7: test-server is a private workspace; its dependencies stay pinned and reach no user",
			"matchFileNames": ["packages/test-server/package.json"],
			"rangeStrategy": "pin",
			"semanticCommitType": "chore",
			"semanticCommitScope": "deps"
		},
		{
			"description": "Rule 8: a peer range keeps its lower bound",
			"matchDepTypes": ["peerDependencies"],
			"rangeStrategy": "widen"
		},
		{
			"description": "engines states the Node.js versions the published packages support; it is raised by hand, not by Renovate (the same as a peer range, rule 8)",
			"matchDepTypes": ["engines"],
			"enabled": false
		},
		{
			"description": "resolutions keep their ranges",
			"matchDepTypes": ["resolutions"],
			"rangeStrategy": "auto"
		},
		{
			"description": "Cargo: Cargo.lock (committed) pins exact versions; bump the Cargo.toml requirement alongside it instead of rewriting it to an `=` pin",
			"matchManagers": ["cargo"],
			"rangeStrategy": "bump"
		},
		{
			"description": "napi-rs crates are released together and must agree on the Node-API binding ABI",
			"groupName": "napi-rs",
			"matchManagers": ["cargo"],
			"matchPackageNames": ["napi", "napi-derive", "napi-build"]
		},
		{
			"groupName": "puppeteer",
			"matchPackageNames": [
				"puppeteer",
				"puppeteer-core",
				"/^@puppeteer\\//",
				"@d-zero/beholder"
			]
		},
		{
			"groupName": "react",
			"matchPackageNames": [
				"react",
				"react-dom",
				"react-router",
				"@types/react",
				"@types/react-dom"
			]
		},
		{
			"groupName": "hono",
			"matchPackageNames": ["hono", "/^@hono\\//"]
		},
		{
			"groupName": "tanstack",
			"matchPackageNames": ["/^@tanstack\\//"]
		},
		{
			"groupName": "textlint",
			"matchPackageNames": [
				"textlint",
				"/^@textlint\\//",
				"/^@textlint-ja\\//",
				"/^textlint-rule-/",
				"/^textlint-plugin-/"
			]
		},
		{
			"groupName": "testing-library",
			"matchPackageNames": ["/^@testing-library\\//"]
		},
		{
			"groupName": "oxlint",
			"matchPackageNames": ["oxlint", "oxlint-tsgolint"]
		},
		{
			"groupName": "markuplint",
			"matchPackageNames": ["@d-zero/markuplint-config", "/^@markuplint\\//"]
		},
		{
			"groupName": "jsdom",
			"matchPackageNames": ["jsdom", "@types/jsdom"]
		},
		{
			"groupName": "vite",
			"matchPackageNames": ["vite", "@vitejs/plugin-react"]
		},
		{
			"groupName": "storybook",
			"matchPackageNames": ["storybook", "/^@storybook\\//"]
		},
		{
			"groupName": "graphology",
			"matchPackageNames": ["/^graphology/", "sigma"]
		},
		{
			"groupName": "sqlite-stack",
			"matchPackageNames": ["knex", "libsql"]
		},
		{
			"groupName": "typescript",
			"matchPackageNames": ["typescript", "@d-zero/tsconfig"]
		},
		{
			"groupName": "@d-zero configs",
			"matchPackageNames": [
				"@d-zero/lint-staged-config",
				"@d-zero/oxlint-config",
				"@d-zero/oxlint-plugin",
				"@d-zero/stylelint-config",
				"@d-zero/textlint-config"
			]
		},
		{
			"groupName": "@d-zero runtime",
			"matchPackageNames": [
				"@d-zero/dealer",
				"@d-zero/fs",
				"@d-zero/google-auth",
				"@d-zero/google-sheets",
				"@d-zero/readtext",
				"@d-zero/roar",
				"@d-zero/shared"
			]
		},
		{
			"groupName": "debug",
			"matchPackageNames": ["debug", "@types/debug"]
		},
		{
			"groupName": "fs-extra",
			"matchPackageNames": ["fs-extra", "@types/fs-extra"]
		},
		{
			"groupName": "tar",
			"matchPackageNames": ["tar", "@types/tar"]
		},
		{
			"groupName": "follow-redirects",
			"matchPackageNames": ["follow-redirects", "@types/follow-redirects"]
		},
		{
			"groupName": "turndown",
			"matchPackageNames": ["turndown", "@types/turndown"]
		},
		{
			"description": "Rule 57: the release automation changes how this repository publishes; a person reviews every update",
			"matchPackageNames": ["@d-zero/release-automation"],
			"automerge": false,
			"addLabels": ["manual-review"]
		},
		{
			"description": "Rule 57: no test that CI runs drives enquirer.prompt (the tests mock it, and the E2E run without a TTY)",
			"matchPackageNames": ["enquirer"],
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"addLabels": ["manual-review"]
		},
		{
			"description": "Rule 57: no test that CI runs goes through the MCP protocol layer or the stdio transport of @modelcontextprotocol/sdk",
			"matchPackageNames": ["@modelcontextprotocol/sdk"],
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"addLabels": ["manual-review"]
		}
	]
}
