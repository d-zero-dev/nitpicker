{
	"name": "@nitpicker/viewer",
	"version": "0.17.0",
	"description": "Local browser viewer for .nitpicker archive files",
	"author": "D-ZERO",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/d-zero-dev/nitpicker.git",
		"directory": "packages/@nitpicker/viewer"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"lib"
	],
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/start-viewer.js",
			"types": "./lib/start-viewer.d.ts"
		},
		"./create-app": {
			"import": "./lib/create-app.js",
			"types": "./lib/create-app.d.ts"
		}
	},
	"scripts": {
		"build": "tsc && vite build",
		"clean": "tsc --build --clean",
		"test:e2e": "node ./e2e/generate-fixture.mjs && playwright test",
		"test:e2e:stub": "node ./e2e/generate-stub-fixture.mjs && playwright test --config playwright.stub.config.ts",
		"test:e2e:directory-tree": "node ./e2e/generate-directory-tree-fixture.mjs && playwright test --config playwright.directory-tree.config.ts",
		"test:e2e:template-clusters": "node ./e2e/generate-template-clusters-fixture.mjs && playwright test --config playwright.template-clusters.config.ts",
		"test:e2e:inbound-links": "node ./e2e/generate-inbound-links-fixture.mjs && playwright test --config playwright.inbound-links.config.ts",
		"test:e2e:crawl-suppression": "node ./e2e/generate-crawl-suppression-fixture.mjs && playwright test --config playwright.crawl-suppression.config.ts"
	},
	"dependencies": {
		"@d-zero/dealer": "1.10.2",
		"@hono/node-server": "2.0.10",
		"@nitpicker/query": "0.17.0",
		"@tanstack/react-query": "5.101.2",
		"@tanstack/react-table": "8.21.3",
		"@tanstack/react-virtual": "3.14.6",
		"graphology": "0.26.0",
		"graphology-layout-forceatlas2": "0.10.1",
		"hono": "4.12.30",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-router": "8.3.0",
		"sigma": "3.0.3"
	},
	"devDependencies": {
		"@d-zero/shared": "0.22.3",
		"@nitpicker/crawler": "0.17.0",
		"@playwright/test": "1.61.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"graphology-types": "0.24.8",
		"jsdom": "29.1.1",
		"vite": "8.1.4"
	}
}
