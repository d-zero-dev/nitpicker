			"types": "./lib/compute-body-hash.d.ts"
		}
	},
	"scripts": {
		"build": "node scripts/build-native.mjs && tsc",
		"clean": "node scripts/build-native.mjs --clean && tsc --build --clean"
	},
	"optionalDependencies": {
		"@nitpicker/core-darwin-arm64": "0.24.0",
		"@nitpicker/core-linux-x64-gnu": "0.24.0"
	}
