{
	"name": "@nitpicker/core",
	"version": "0.24.0",
	"description": "Native (Rust, Node-API) compute core for Nitpicker",
	"author": "D-ZERO",
	"license": "Apache-2.0",
	"engines": {
		"node": "v26.11.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/d-zero-dev/nitpicker.git",
		"directory": "packages/@nitpicker/core"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"lib"
	],
	"type": "module",
	"exports": {
