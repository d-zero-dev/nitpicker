{
	"name": "@nitpicker/core",
	"version": "0.24.0",
	"description": "Native (Rust, Node-API) compute core for Nitpicker",
	"author": "D-ZERO",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=24.11.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/d-zero-dev/nitpicker.git",
		"directory": "packages/@nitpicker/core"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"lib"
	],
	"type": "module",
	"exports": {
		"./compute-alias-keys": {
			"import": "./lib/compute-alias-keys.js",
			"types": "./lib/compute-alias-keys.d.ts"
		},
		"./compute-body-hash": {
			"import": "./lib/compute-body-hash.js",
			"types": "./lib/compute-body-hash.d.ts"
		},
		"./compute-url-sort-ranks": {
			"import": "./lib/compute-url-sort-ranks.js",
			"types": "./lib/compute-url-sort-ranks.d.ts"
		},
		"./create-isolated-cluster-run": {
			"import": "./lib/create-isolated-cluster-run.js",
			"types": "./lib/create-isolated-cluster-run.d.ts"
		},
		"./create-template-classification-run": {
			"import": "./lib/create-template-classification-run.js",
			"types": "./lib/create-template-classification-run.d.ts"
		},
		"./group-alias-candidates": {
			"import": "./lib/group-alias-candidates.js",
			"types": "./lib/group-alias-candidates.d.ts"
		},
		"./match-js-license-comment-signal": {
			"import": "./lib/match-js-license-comment-signal.js",
			"types": "./lib/match-js-license-comment-signal.d.ts"
		},
		"./match-selector-html": {
			"import": "./lib/match-selector-html.js",
			"types": "./lib/match-selector-html.d.ts"
		},
		"./match-selector-snapshots": {
			"import": "./lib/match-selector-snapshots.js",
			"types": "./lib/match-selector-snapshots.d.ts"
		},
		"./match-structural-technology-signals": {
			"import": "./lib/match-structural-technology-signals.js",
			"types": "./lib/match-structural-technology-signals.d.ts"
		},
		"./template-exact-page-limit": {
			"import": "./lib/template-exact-page-limit.js",
			"types": "./lib/template-exact-page-limit.d.ts"
		},
		"./template-memory-budget": {
			"import": "./lib/template-memory-budget.js",
			"types": "./lib/template-memory-budget.d.ts"
		},
		"./template-block-sample-size": {
			"import": "./lib/template-block-sample-size.js",
			"types": "./lib/template-block-sample-size.d.ts"
		},
		"./types": {
			"import": "./lib/types.js",
			"types": "./lib/types.d.ts"
		}
	},
	"scripts": {
		"build": "node scripts/build-native.mjs && tsc",
		"clean": "node scripts/build-native.mjs --clean && tsc --build --clean"
	},
	"optionalDependencies": {
		"@nitpicker/core-darwin-arm64": "0.24.0",
		"@nitpicker/core-linux-x64-gnu": "0.24.0"
	}
}
