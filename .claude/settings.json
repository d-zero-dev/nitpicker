{
	"permissions": {
		"deny": [
			"Read(**/.env)",
			"Read(**/.env.*)",
			"Edit(**/.env)",
			"Edit(**/.env.*)",
			"Write(**/.env)",
			"Write(**/.env.*)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "npx -y gh-setup-hooks",
						"timeout": 120
					}
				]
			}
		]
	}
}
